# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Load with: node --env-file=.env cli.js submit <input>   (Node 20.6+)
MLUX_HOST=login.example.lu
MLUX_PORT=8822
MLUX_USER=your-user
MLUX_KEY=/home/you/.ssh/id_ed25519_mlux
# MLUX_KEY_PASSPHRASE=          # only if the key has one and you don't use ssh-agent
MLUX_REMOTE_DIR=/project/home/your-project/your-user
MLUX_JOB_SCRIPT=path/to/job.sh
